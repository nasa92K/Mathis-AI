# ─────────────────────────────────────────────────────────────
#  MATHIS AI — configuration du backend
#  Copie ce fichier en ".env" puis remplis ta clé API.
#  Le fichier .env ne doit JAMAIS être commité ni envoyé au frontend.
# ─────────────────────────────────────────────────────────────

# Clé API Groq (obligatoire, gratuite) — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle utilisé par Mathis AI (liste : https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Niveau de réflexion du modèle : low | medium | high
# "low" = réponses plus rapides et moins de tokens consommés sur l'offre gratuite.
MATHIS_EFFORT=low

# Nombre maximum de tokens générés par réponse
MAX_TOKENS=2048

# Taille maximale de l'historique envoyé à l'IA (en caractères, messages les plus récents)
MAX_HISTORY_CHARS=8000

# Port du serveur Express
PORT=3001

# Origines autorisées, séparées par des virgules (frontend Vite + site HubSpot)
CLIENT_ORIGIN=http://localhost:5173

# Nombre de proxys devant le serveur : 0 en local, 1 sur Render
TRUST_PROXY=0

# Limite de requêtes par adresse IP (fenêtre d'une minute)
RATE_LIMIT_PER_MINUTE=20

# Recherche web pour vérifier les faits et citer des sources (outil browser_search de Groq,
# modèles gpt-oss uniquement). Mets "false" pour la couper si ton quota gratuit sature.
MATHIS_WEB_SEARCH=true
