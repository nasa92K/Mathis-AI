# ─────────────────────────────────────────────────────────────
#  MATHIS AI — configuration du backend
#  Copie ce fichier en ".env" puis remplis ta clé API.
#  Le fichier .env ne doit JAMAIS être commité ni envoyé au frontend.
# ─────────────────────────────────────────────────────────────

# Clé API Anthropic (obligatoire) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle Claude utilisé par Mathis AI
ANTHROPIC_MODEL=claude-opus-5-5

# Niveau de réflexion du modèle : low | medium | high | xhigh | max
# "medium" = bon équilibre qualité / vitesse / coût pour un chatbot.
MATHIS_EFFORT=medium

# Nombre maximum de tokens générés par réponse
MAX_TOKENS=64000

# Repli automatique côté serveur si le modèle refuse une demande
# (paramètre bêta "fallbacks"). Mets "false" si ton compte le refuse.
MATHIS_ENABLE_FALLBACKS=true

# Port du serveur Express
PORT=3001

# Origines autorisées, séparées par des virgules (frontend Vite + site HubSpot)
CLIENT_ORIGIN=http://localhost:5173

# Nombre de proxys devant le serveur : 0 en local, 1 sur Render
TRUST_PROXY=0

# Limite de requêtes par adresse IP (fenêtre d'une minute)
RATE_LIMIT_PER_MINUTE=20
